# Azure AI Foundry
# For Foundry resource endpoints (*.services.ai.azure.com), either form works:
#   https://YOUR_RESOURCE.services.ai.azure.com/
#   https://YOUR_RESOURCE.services.ai.azure.com/api/projects/YOUR_PROJECT
# The app normalizes these to /openai/v1 for chat completions.
# Classic Azure OpenAI also works: https://YOUR_RESOURCE.openai.azure.com/
AZURE_AI_FOUNDRY_ENDPOINT=https://YOUR_RESOURCE.services.ai.azure.com/
AZURE_AI_FOUNDRY_API_KEY=your-azure-api-key
AZURE_AI_FOUNDRY_DEPLOYMENT=your-deployment-name
# Used only for classic *.openai.azure.com endpoints
AZURE_API_VERSION=2024-08-01-preview

# Serper.dev Google Search (Hotel Finder)
SERPER_API_KEY=your-serper-api-key

# SerpApi Google Flights (Flight Buddy MCP)
SERPAPI_API_KEY=your-serpapi-api-key

# Optional: absolute path to flight MCP server.py (defaults to ../mcp-servers/flight-buddy/server.py)
# FLIGHT_MCP_SERVER=

# Optional
CORS_ORIGINS=http://localhost:5173
MAX_TOOL_ROUNDS=3
