{
  "version": "2.0",
  "extensions": {
    "mcp": {
      "instructions": "Flight Buddy MCP: search, rank, and summarize live flights via SerpApi Google Flights.",
      "serverName": "flight-buddy-mcp",
      "serverVersion": "1.0.0",
      "system": {
        "webhookAuthorizationLevel": "System"
      }
    }
  },
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle.Preview",
    "version": "[4.*, 5.0.0)"
  }
}
